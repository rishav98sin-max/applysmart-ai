# ApplySmart AI — environment template
# Copy to `.env` and fill in real values. Never commit the populated `.env`.

# ─── Required ──────────────────────────────────────────────────────────────
# Primary LLM provider: Groq for fast tasks (matcher, planner, supervisor,
# reviewer, cv_structure_reader). Writing tasks (CV tailoring, cover letters)
# go through DeepSeek when configured (see DEEPSEEK_API_KEY below); otherwise
# they fall back to Groq as well.
GROQ_API_KEY=gsk_your_primary_key_here

# Email delivery — Gmail SMTP (app password).
# Generate at https://myaccount.google.com/apppasswords (requires 2FA on).
EMAIL_ADDRESS=you@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password

# ─── Optional — Groq key rotation pool ─────────────────────────────────────
# Add up to 7 more keys from different Groq accounts. When one hits its
# per-minute or daily quota, the app auto-rotates. Ceiling ≈ 800K tokens/day
# with all 8 slots populated.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_API_KEY_8=

# ─── Optional — DeepSeek V4 (recommended for CV tailoring quality) ─────────
# DeepSeek V4-Flash gives noticeably stronger instruction-following than
# Llama 3.3 70B for the cv_diff_tailor stage at ~$0.001 per call. With a
# key set here, the tailor tries DeepSeek first and falls back to
# Groq automatically if anything fails. Without a key, behaviour is
# unchanged from the free-tier Groq path.
# Get a key at https://platform.deepseek.com (top up $2-5 — DeepSeek no longer
# offers free signup credit as of late 2025).
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat   # default; = V4-Flash non-thinking (cheapest)
# DEEPSEEK_MODEL=deepseek-v4-pro # stronger reasoning, ~12× the cost

# ─── Optional — Langfuse tracing (consent-gated in-app) ────────────────────
# Set DIAGNOSTICS_ENABLED=1 to activate; see diagnostics/README.md. Without
# these keys the diagnostics layer still emits local JSONL traces.
DIAGNOSTICS_ENABLED=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ─── Optional — product analytics (Mixpanel) ───────────────────────────────
# See docs/MIXPANEL_DASHBOARD.md for setup + live dashboard reference.
MIXPANEL_TOKEN=
MIXPANEL_REGION=US   # or EU — must match your Mixpanel project's residency

# ─── Optional — DOCX editing path ─────────────────────────────────────────
# Always enabled for native .docx uploads. PDF uploads use the in-place
# PyMuPDF replica path; the historic pdf2docx PDF→DOCX bridge was removed
# Jun 2026 (non-deterministic corruption on real CVs).
DOCX_PATH_ENABLED=1

# ─── Optional — runtime knobs (see README §Configuration for full list) ────
# GROQ_MODEL=llama-3.3-70b-versatile
# MAX_LLM_CALLS_PER_RUN=60
# MAX_TAILOR_RETRIES=1
# REVIEWER_ACCEPT_THRESHOLD=72
# USE_VECTOR_RETRIEVAL=1
# REPLICA_LLM_PRIMARY=1            # LLM-primary parser (default ON in prod)
# REPLICA_LLM_SAMPLES=3            # consensus-N for the LLM reader
# APPLYSMART_REAIM=1               # re-aim best-of-N tailor engine
# BOARD_ESCALATION=1               # escalate to next live board on empty scrape
# BOARD_FAIL_COOLDOWN_AT=2         # park a board after N consecutive empties
